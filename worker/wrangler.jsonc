{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "latamace-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-05",

  // Rota no próprio domínio do site em vez de um api.latamace.com separado:
  // mesma origem, então some o CORS entre página e API, e não precisa de
  // registro de DNS novo. O GitHub Pages não serve nada em /api, então não
  // há conflito — a rota intercepta antes de chegar no origin.
  "routes": [
    { "pattern": "latamace.com/api*", "zone_name": "latamace.com" }
  ],

  // Cache das respostas do Apps Script. Ver comentário no src/index.js.
  "kv_namespaces": [
    { "binding": "CACHE", "id": "628377b6b2e64248b062a182a3330762" }
  ],

  // Reaquece as chaves caras de hora em hora. Não precisa ser mais que isso:
  //  - a RAW CTS é atualizada 1x/dia;
  //  - o Apps Script cacheia 30 min do lado dele, então reaquecer mais rápido
  //    devolveria os mesmos bytes gastando execução;
  //  - e o stale-while-revalidate já cobre o intervalo: quem chega com a chave
  //    vencida recebe a cópia velha na hora e dispara a atualização atrás.
  // O cron existe pro caso "ninguém acessou desde ontem" — pra que o primeiro
  // visitante do dia não pague os 60s.
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
